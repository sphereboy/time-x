# Google Search Console site verification token.
# Get it from: https://search.google.com/search-console -> Settings -> Ownership verification -> HTML tag.
# Paste the value of the `content` attribute (no quotes).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Upstash Redis credentials used by src/lib/ratelimit.ts.
# Create a database at https://console.upstash.com/redis and copy the REST URL + REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
